        }
      ]
    },
    {
      "id": "claim_72661c4871514b099c1750767607d421",
      "statement": "Durability modes control checkpoint persistence: 'sync' persists before the next superstep, 'async' persists during superstep execution, and 'exit' accumulates writes and persists only at graph termination.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/pregel/_loop.py#L415-L549",
