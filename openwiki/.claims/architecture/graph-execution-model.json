    },
    {
      "id": "claim_083c3de12841433988eb2d7b098cc63e",
      "statement": "PregelRunner (sync and async variants) executes tasks in parallel using ThreadPoolExecutor (sync) or asyncio task groups (async), applying retry policies, cache policies, timeout, and routing failures to error handlers; tasks execute with the node's bound runnable and the injected config containing read/send callbacks.",
      "evidence": [
        {
