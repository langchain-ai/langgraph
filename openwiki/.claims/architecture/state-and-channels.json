    },
    {
      "id": "claim_1299c1fac2b64106a0f2139cdb5a5644",
      "statement": "BinaryOperatorAggregate applies a binary operator (e.g., operator.add, operator.or_) to aggregate concurrent updates. It is selected when a field is annotated with a callable having exactly 2 positional parameters, providing a simple alternative to custom DeltaChannel reducers.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/binop.py#L65-L145",
          "version": "repo-lines-v1:sha256:956f7dfb145f48b996408e8fd1759a6e6b8721000168895e723b49f9a252f987:"
        }
