  "claims": [
    {
      "id": "claim_b54884d00ae549639d5c62e98d1657f8",
      "statement": "State is the primary abstraction for inter-node communication in LangGraph: all nodes read from and write to typed, versioned state rather than passing data through function calls. State enables concurrent writes (merged via reducers), checkpointable snapshots at each superstep, and incremental execution via version tracking.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L131-L145",
          "version": "repo-lines-v1:sha256:3d7559665d45a74bc9c1c7276272deaef54f4def63ac8660cccecd3dfd8c5263:"
        },
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L200-L240",
          "version": "repo-lines-v1:sha256:37b5bf7d6a12bcb9d3362fec297c7e9fd0133c2ae06aee47f4713a0e6efa2948:"
        }
      ]
    },
    {
      "id": "claim_3125d838bdcf432eb98ab98024ae10ac",
      "statement": "A channel is a typed, versioned container for a single state field. Each channel has a version that increments when updated. Channel versions enable the scheduler to determine which nodes have unprocessed inputs by comparing channel versions to per-node versions_seen records.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/base.py#L19-L121",
          "version": "repo-lines-v1:sha256:bfbd8e10e5d0aaf6c83be19c2c5ad977e0668c16fedd641838513fb04df2c201:"
        }
      ]
    },
    {
      "id": "claim_0492eb23a62a478ab68abb33ccd4f374",
      "statement": "LastValue channels store the most recent value and enforce a strict invariant: exactly one update per superstep. Multiple concurrent updates to an unannotated field raise InvalidUpdateError, preventing accidental concurrent writes to non-aggregatable state.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/last_value.py#L20-L79",
          "version": "repo-lines-v1:sha256:5ebbe3176869843c229a06271ce2046b74c02f2f2912eabccfae7c2418d2bebc:"
        }
      ]
    },
    {
      "id": "claim_af1d468922144503a8d20e5cfd96b238",
      "statement": "DeltaChannel accumulates updates by replaying writes through a reducer: new_state = reducer(state, [update1, update2, ...]). It stores only a sentinel in checkpoints and reconstructs state by replaying ancestor writes, with configurable snapshot frequency (default 1000 updates) to bound replay depth.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/delta.py#L25-L150",
          "version": "repo-lines-v1:sha256:e86582f9b86fff5d4989c0c63f52336e22da143a6eefdc3bdc13072ff4dd9437:"
        }
      ]
    },
    {
      "id": "claim_aeef6f3457af4594a93f96793d1b93fa",
      "statement": "EphemeralValue channels store a value available only during the current superstep and are cleared after reads. With guard=True (default), they enforce at most one update per superstep. Used internally for input passed via Send() to dynamically routed nodes.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/ephemeral_value.py#L15-L79",
          "version": "repo-lines-v1:sha256:585ba825104d152f457d4fe02d31fb40b33b78118a10047ddab4a7f534fdc63f:"
        }
      ]
    },
    {
      "id": "claim_f0234775ec4b4bb4a20128fcfb576ceb",
      "statement": "NamedBarrierValue is a synchronization primitive that collects named updates and becomes available only after all expected names have written at least once. After consumption, the seen set resets. Used to ensure all parallel branches complete before proceeding.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/named_barrier_value.py#L13-L82",
          "version": "repo-lines-v1:sha256:8e40e299f18a646389690fe36a6651923571a4cada71db61933ee6ec01b79d22:"
        }
      ]
    },
    {
      "id": "claim_cfd85ecca61e434494215217b6fc821b",
      "statement": "Topic is a queue-like channel that stores a deque of messages. Each update flattens and appends values. If accumulate=False (default), the channel empties after reads. Used internally to store Send objects for dynamic node dispatch.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/topic.py#L23-L94",
          "version": "repo-lines-v1:sha256:f7d07f3a5d1bb65d34c8e0840c2f02a3ef29364e5070d063812bcbb4789610fb:"
        }
      ]
    },
    {
      "id": "claim_c08e94dae29745cdbdc39cb0074b46d3",
      "statement": "Reducers must be batching-invariant (associative): reducer(reducer(a, xs), ys) == reducer(a, xs+ys). This property allows LangGraph to replay checkpointed writes in larger batches than originally produced without changing reconstructed state.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/channels/delta.py#L43-L48",
          "version": "repo-lines-v1:sha256:9081ed65cc6bdc9792cc9ed1db08790e12b08129c469b82c14c626a66ed73941:"
        },
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L136-L140",
          "version": "repo-lines-v1:sha256:793ebc7781bf7fff91a24735b3b8d92dad8f7880b64f70de7cbdddf2c5c55f67:"
        }
      ]
    },
    {
      "id": "claim_24c581cb196245a48aa4db50a9b6f498",
      "statement": "add_messages is a specialized reducer for message lists that appends new messages, deduplicates by message ID (replacing earlier messages with same ID), and supports RemoveMessage to tombstone entries. It is the idiomatic pattern for multi-turn conversations.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/message.py#L60-L160",
          "version": "repo-lines-v1:sha256:d851bcccd9644a38c1b463493ca082c68feff6ca812fdb33c63bf7282e87832c:"
        }
      ]
    },
    {
      "id": "claim_03c2241411aa48e492d3435405311cc0",
      "statement": "StateGraph automatically selects channel implementations based on type annotations: explicit BaseChannel instances are used directly; BaseChannel subclass annotations instantiate with the type; callable annotations with 2 positional parameters create BinaryOperatorAggregate; unannotated fields create LastValue.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L1876-L1923",
          "version": "repo-lines-v1:sha256:56c39aecba30a6237b79f11f70f94eec47469f5280bf75da2ca8004fb2474557:"
        }
      ]
    },
    {
      "id": "claim_3f0f528d96774c619b2ad2f70a08a665",
      "statement": "input_schema is an optional schema defining the external data shape passed to invoke() or stream(). A mapper extracts matching field names from input and passes only those to nodes. Defaults to state_schema if not specified. Allows decoupling user-facing API from internal state shape.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L1516-L1524",
          "version": "repo-lines-v1:sha256:f879be996bc69b516087009b77f82ab9b90c8d26135dc80abd4695355ad7a591:"
        },
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L152-L153",
          "version": "repo-lines-v1:sha256:91f4df4828975e1ee0f1aec35681501962f59b8a93f5fec7ba44a9bf0887a451:"
        }
      ]
    },
    {
      "id": "claim_9b8e6c5b821847c0a4a32458138f5b38",
      "statement": "output_schema is an optional schema defining which state fields are returned from invoke() or final state in streaming. Only fields in output_schema are included in the response; others remain hidden as private channels. Defaults to state_schema if not specified.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L1270-L1279",
          "version": "repo-lines-v1:sha256:55f3990301aeef6157bc014e0e92340f54e9538be31768e5bb40ac7c35ad1544:"
        },
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L153-L154",
          "version": "repo-lines-v1:sha256:2125ac0c26b4ae49d891104cc18fb8a425482c3af75872823dfef72c18aae543:"
        }
      ]
    },
    {
      "id": "claim_2d830b4de4a94740a30ab4a969fbe079",
      "statement": "Fields present in state_schema but absent from output_schema are private channels: they are maintained internally during execution but never returned to users. This allows hiding implementation details like intermediate embeddings or scratch space.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L1270-L1279",
          "version": "repo-lines-v1:sha256:55f3990301aeef6157bc014e0e92340f54e9538be31768e5bb40ac7c35ad1544:"
        }
      ]
    },
    {
      "id": "claim_719b973daea04de09f2f5b5477dc515d",
      "statement": "context_schema is an optional schema for immutable, run-scoped data passed to all nodes via runtime.context without polluting state. Used for configuration, user IDs, database connections, and other per-invocation resources.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L151-L152",
          "version": "repo-lines-v1:sha256:72f9bc299f88f1d36881d02ea7ba7363b4fc65f347d9c82bc760bbd47f386b68:"
        }
      ]
    },
    {
      "id": "claim_bcd5c1d36f164e8faf40a37082ca8f18",
      "statement": "Managed values are special state fields auto-populated by the runtime with deterministic data (e.g., is_last_step). They are available only during node execution, not in checkpoints, and do not participate in version tracking or trigger dependent nodes.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/managed/base.py#L18-L31",
          "version": "repo-lines-v1:sha256:38089f10f887620540abc3958616eedf4d2173bb31b191b460fef6f85a9b439d:"
        }
      ]
    },
    {
      "id": "claim_f7a7fdb801fa478a8b4e9f09c30c418e",
      "statement": "Nodes can have a custom input_schema different from graph state_schema, allowing them to receive only a subset of fields via field name matching. A mapper extracts the subset at runtime, simplifying node signatures and enabling selective state access.",
      "evidence": [
        {
          "resource": "repo://libs/langgraph/langgraph/graph/state.py#L1516-L1524",
