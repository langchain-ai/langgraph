    },
    {
      "id": "claim_61f9591b673c4074b334e96e60eb6855",
      "statement": "Reducer functions are user-provided or built-in (operator.add, operator.or_, etc.) and must accept two parameters: an accumulated value and a sequence of updates, returning a merged value. They enable safe concurrent writes by merging updates rather than raising errors.",
      "evidence": [
