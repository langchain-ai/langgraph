    {
      "id": "claim_d4ac8b2341f64e9d8d22f0274eb514b4",
      "statement": "ToolNode is a RunnableCallable that extracts tool calls from AIMessage tool_calls or direct tool_call input formats, validates tool names against its tools_by_name registry, injects state/store/runtime context into tool parameters via InjectedState/InjectedStore annotations, executes tools in parallel via thread pool or async executor, handles errors per handle_tool_errors configuration, and returns ToolMessage objects with results or error content.",
      "evidence": [
        {
