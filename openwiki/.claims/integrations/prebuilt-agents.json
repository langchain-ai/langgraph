  "claims": [
    {
      "id": "claim_d4d60e9b8ac44560b9ebb4cc3244b9ff",
      "statement": "create_react_agent() is a factory function that builds a compiled StateGraph implementing a ReAct-style agent loop: it takes a language model and tools as input, automatically binds tools to the model, creates an \"agent\" node for LLM calls and a \"tools\" node for tool execution via ToolNode, routes conditionally between them based on tool call presence, and returns a CompiledStateGraph runnable.",
      "evidence": [
        {
          "resource": "repo://libs/prebuilt/langgraph/prebuilt/chat_agent_executor.py#L278-L308",
          "version": "repo-lines-v1:sha256:57fc403d0f6bb9cec6ccecea81eeece0dfd536fe6a3dda17709e2194ca8053b2:"
        },
        {
