    {
      "id": "claim_c64b5928ee9c446698d5296cd3d4acec",
      "statement": "Agent state uses a messages list with add_messages reducer that deduplicates and accumulates conversation history across multiple agent-tool-agent cycles, enabling the model to see the full interaction context including tool results in ToolMessage format.",
