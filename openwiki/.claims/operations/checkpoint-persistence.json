    {
      "id": "claim_e8f138e1ef42425f86b5e842bc9da14b",
      "statement": "Pending writes are PendingWrite tuples (task_id, channel_name, value) stored when a node task succeeds but checkpoint save fails; on resumption, these writes are replayed before scheduling next tasks, ensuring side effects are not lost to downstream failures.",
