    },
    {
      "id": "claim_75b96f56bc8b460cb7fbf9ea13fc8d0d",
      "statement": "All Docker Compose services (Postgres, Redis, API) have health checks: Postgres uses `pg_isready`, Redis uses `redis-cli ping`, API uses `python /api/healthcheck.py` (Docker >= 25.0); the LangGraph API depends_on Postgres and Redis with service_healthy condition.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/docker.py#L222-L293",
          "version": "repo-lines-v1:sha256:01ee7d0647cdb7f98880d1f54e4b7f59ed5d77ad58a9151af8eb6947e5e5d7e0:"
        }
      ]
    },
    {
      "id": "claim_0a20d54c1f6746d7a0441c7377266a76",
      "statement": "Environment variables are loaded from (in priority order): system environment, .env file (if env path specified in config), and config env dict; required variables include LANGSMITH_API_KEY (dev) or LANGGRAPH_CLOUD_LICENSE_KEY (production), and auto-set POSTGRES_URI/REDIS_URI in Docker Compose.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/cli.py#L838-L862",
          "version": "repo-lines-v1:sha256:154ce410348e1d5a3db4c29a1bb0b0e982c58f3c1f957301d4c0d327df9904cd:"
        }
