    {
      "id": "claim_e0b8f7f0557742088aff3a88c0ab15d6",
      "statement": "The build command supports multi-platform image creation via --platform (e.g., linux/amd64,linux/arm64), which requires Docker Buildx; images are cross-compiled and pushed to the registry with the same tag when --push is specified.",
