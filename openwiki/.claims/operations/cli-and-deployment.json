    {
      "id": "claim_3337206976714887ab80dd660e9cad8d",
      "statement": "The LangGraph CLI provides five main commands: `langgraph new` for project scaffolding, `langgraph dev` for in-process development with hot reload, `langgraph build` for Docker image creation, `langgraph up` for Docker Compose deployment with managed Postgres and Redis services, and `langgraph deploy` for remote deployment to LangSmith.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/cli.py#L230-L240",
          "version": "repo-lines-v1:sha256:443ec4ef8fca9c24e8b0a9c7b80a0bb76962564086277672884b629c3dd588ac:"
        },
        {
