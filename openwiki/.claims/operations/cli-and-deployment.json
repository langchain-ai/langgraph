    {
      "id": "claim_a9b8a5df014c47269db1f30d18dce09f",
      "statement": "`langgraph dev` runs the LangGraph API server in-process using the `langgraph_api` package, with automatic hot-reload on file changes (unless --no-reload specified), optional remote debugging via --debug-port, and browser auto-open (unless --no-browser specified).",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/cli.py#L758-L862",
          "version": "repo-lines-v1:sha256:e7e3a073c4d643ce5cfb664b6711d92c3df1a394b9a9c878cd44c3214cf421f8:"
        }
      ]
    },
    {
      "id": "claim_cc1e4cecb6b54cec88b5d4ba0f79ea35",
      "statement": "`langgraph build` generates a Dockerfile from the config, optionally pulls the latest base image, and runs `docker build` to create a tagged image, with support for multi-platform builds via --platform (requires Docker Buildx) and custom install/build commands.",
      "evidence": [
        {
