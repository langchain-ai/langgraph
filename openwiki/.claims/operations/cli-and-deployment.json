    },
    {
      "id": "claim_9596da609d2c4fb4b0edf4a3bab63c06",
      "statement": "langgraph.json declares graph definitions (path:object references or @entrypoint decorated functions), dependencies (PyPI or local paths), environment variables (file or dict), Python/Node version, store/checkpointer/auth/http/webhooks/ui configuration, and container build options (python_version, dockerfile_lines, keep_pkg_tools).",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/schemas.py#L620-L774",
