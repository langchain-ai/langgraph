    },
    {
      "id": "claim_4aee264338934b7cb3fa255046e4ec84",
      "statement": "`langgraph dockerfile` generates a Dockerfile and optional .dockerignore, docker-compose.yml, and .env template; supports --add-docker-compose to emit a complete deployment setup suitable for custom CI/CD or container registries.",
