        }
      ]
    },
    {
      "id": "claim_8ab6bc1139eb4ac89bca92255b0f4eea",
      "statement": "`langgraph up` launches a Docker Compose stack with default services: PostgreSQL 16 with pgvector (langgraph-postgres on port 5433), Redis 6 (langgraph-redis), and LangGraph API server bound to --port (default 8123), all with health checks; optionally includes a debugger UI when --debugger-port is specified.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/cli.py#L278-L372",
          "version": "repo-lines-v1:sha256:9b74a000954cc5c6419948c19b088d4bb8e0605a1e67d8e1c2d079bfc934bc94:"
