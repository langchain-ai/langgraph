    {
      "id": "claim_96990bbf7f2e4e3ca7a7cd26761885b7",
      "statement": "Two engine runtime modes are supported: 'combined_queue_worker' (default, single container with queue and workers), and 'distributed' (separate orchestrator and executor containers for horizontal scaling); configured via --engine-runtime-mode in up/build/dockerfile commands.",
