        }
      ]
    },
    {
      "id": "claim_1797cb7bbe674957bdf76649a7c44e56",
      "statement": "Graphs are discovered via explicit `path/to/file.py:object_name` references in config or automatically via `@entrypoint()` decorator; the CLI adds config dependencies to sys.path, imports the module, retrieves the named object (Pregel/StateGraph or async context manager), and registers it as an assistant.",
      "evidence": [
        {
          "resource": "repo://libs/cli/langgraph_cli/cli.py#L828-L862",
          "version": "repo-lines-v1:sha256:9c82e2b8510393b5bd0bf4bf1c689b284a2a4cd7c19f8fc517a9b3fd8713db5c:"
